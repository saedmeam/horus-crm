// Prisma Schema para Horustech CRM (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SALES
  TECH
  SUPERVISOR
}

enum ChannelType {
  WHATSAPP_VENTAS_1
  WHATSAPP_VENTAS_2
  FACEBOOK
  INSTAGRAM
  TIKTOK
  WEBCHAT
  CANAL_3D
  SOPORTE_RISPACS
}

enum ConversationStatus {
  UNASSIGNED
  OPEN
  PENDING
  CLOSED
}

enum PipelineStage {
  NUEVO_LEAD
  EN_NEGOCIACION
  VENTA_GANADA
  VENTA_PERDIDA
}

enum MediaType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT_PDF
  FILE_3D_STL
  FILE_DICOM
}

enum SenderType {
  CLIENT
  AGENT
  AI_BOT
  SYSTEM
}

model User {
  id               String          @id @default(uuid())
  respondUserId    String?         @unique // Ej: 1179198 (Sofia), 1179200 (Mario), 1179201 (Edgar)
  name             String
  email            String          @unique
  passwordHash     String
  role             Role            @default(SALES)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  assignedContacts Contact[]
  conversations    Conversation[]
  reminders        Reminder[]
  internalComments InternalComment[]
  messages         Message[]
}

model Contact {
  id               String          @id @default(uuid())
  phone            String          @unique
  name             String?
  city             String?
  institution      String?         // Nombre de clÃ­nica o empresa
  assignedUserId   String?
  assignedUser     User?           @relation(fields: [assignedUserId], references: [id])
  lastIncomingAt   DateTime?       // Fecha clave para la regla de los 90 dÃ­as
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  conversations    Conversation[]
  reminders        Reminder[]
  backorders       Backorder[]
  tags             ContactTag[]
}

model Conversation {
  id               String             @id @default(uuid())
  contactId        String
  contact          Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel          ChannelType
  status           ConversationStatus @default(UNASSIGNED)
  stage            PipelineStage      @default(NUEVO_LEAD)
  assignedUserId   String?
  assignedUser     User?              @relation(fields: [assignedUserId], references: [id])
  aiActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  messages         Message[]
  internalComments InternalComment[]
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType       SenderType
  senderUserId     String?
  senderUser       User?        @relation(fields: [senderUserId], references: [id])
  content          String?      @db.Text
  mediaUrl         String?
  mediaType        MediaType    @default(TEXT)
  metaMessageId    String?      @unique // ID del mensaje en WhatsApp Cloud API
  status           String?      // SENT, DELIVERED, READ
  createdAt        DateTime     @default(now())
}

model InternalComment {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId         String
  author           User         @relation(fields: [authorId], references: [id])
  content          String       @db.Text
  mentions         String[]     // Array de User IDs mencionados
  createdAt        DateTime     @default(now())
}

model Reminder {
  id               String       @id @default(uuid())
  contactId        String
  contact          Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledFor     DateTime     // Fecha y hora del recordatorio pactado
  notes            String       @db.Text
  isCompleted      Boolean      @default(false)
  createdAt        DateTime     @default(now())
}

model Backorder {
  id               String       @id @default(uuid())
  contactId        String
  contact          Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  productName      String
  category         String?      // Resinas, Filamentos, Repuestos, EscÃ¡neres
  quantity         Int          @default(1)
  specification    String?      // Color, grosor, marca solicitada
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())
}

model ContactTag {
  id               String       @id @default(uuid())
  contactId        String
  contact          Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagName          String
  createdAt        DateTime     @default(now())

  @@unique([contactId, tagName])
}