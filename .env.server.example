# ============================================================
# Conexión a la BASE DE DATOS DEL SERVIDOR (producción/adicional)
# Copia este archivo a `.env.server` y edita los valores reales.
# ============================================================

# Base de datos PostgreSQL del servidor
# Formato: postgresql://USUARIO:CONTRASEÑA@IP_DEL_SERVIDOR:5432/NOMBRE_DB?schema=public
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@IP_DEL_SERVIDOR:5432/horustech_crm?schema=public

# URL pública del backend (para que el frontend se conecte)
# Usa la IP o dominio del servidor, NO localhost.
NEXT_PUBLIC_API_URL=http://IP_DEL_SERVIDOR:4001

# Puerto del backend
PORT=3001
