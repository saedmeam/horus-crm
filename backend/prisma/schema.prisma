// Prisma Schema para Horustech CRM (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id              String   @id @default(uuid())
  name            String   @unique
  canViewAllChats Boolean  @default(false)
  screenAccess    Json     @default("[]")
  users           User[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ConversationStatus {
  UNASSIGNED
  OPEN
  PENDING
  CLOSED
}



enum MediaType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT_PDF
  FILE_3D_STL
  FILE_DICOM
}

enum SenderType {
  CLIENT
  AGENT
  AI_BOT
  SYSTEM
}

model User {
  id               String          @id @default(uuid())
  respondUserId    String?         @unique // Ej: 1179198 (Sofia), 1179200 (Mario), 1179201 (Edgar)
  name             String
  username         String?         @unique
  email            String          @unique
  passwordHash     String
  roleId           String?
  businessLine     String          @default("SM") // "SM", "3D", "ALL"
  signatureUrl     String?         // Firma del tecnico (opcional)
  role             Role?    @relation(fields: [roleId], references: [id])
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  lines            WhatsAppLine[]
  assignedContacts Contact[]
  conversations    Conversation[]
  collaboratingIn  Conversation[] @relation("ConversationCollaborators")
  reminders        Reminder[]
  internalComments InternalComment[]
  messages         Message[]
  pushSubscriptions PushSubscription[]
  tickets           Ticket[]
  ticketReports     TicketReport[]

}

model WhatsAppLine {
  id               String          @id @default(uuid())
  phoneNumberId    String          @unique // El ID numérico de la API de Meta
  wabaId           String?         // ID de la cuenta de WhatsApp Business (opcional, si usas varias cuentas)
  token            String?         // Token de acceso específico de este número (opcional; vacío = usa el global)
  name             String          // Ej: 'Ventas 1', 'Soporte'
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  users            User[]          // Usuarios que tienen acceso a esta línea
  conversations    Conversation[]
}

model Contact {
  id               String          @id @default(uuid())
  phone            String          @unique
  name             String?
  email            String?
  city             String?
  institution      String?
  assignedUserId   String?
  assignedUser     User?           @relation(fields: [assignedUserId], references: [id])
  customFields     Json?           @default("{}")
  lastIncomingAt   DateTime?       
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  conversations    Conversation[]
  reminders        Reminder[]
  backorders       Backorder[]
  tags             ContactTag[]
}

model Conversation {
  id               String             @id @default(uuid())
  contactId        String
  contact          Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel          String             @default("whatsapp")
  whatsappLineId   String?
  whatsappLine     WhatsAppLine?      @relation(fields: [whatsappLineId], references: [id])
  status           ConversationStatus @default(UNASSIGNED)
  stage            String             @default("NUEVO_LEAD")
  assignedUserId   String?
  assignedUser     User?              @relation(fields: [assignedUserId], references: [id])
  collaborators    User[]             @relation("ConversationCollaborators")
  aiActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  messages         Message[]
  internalComments InternalComment[]
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType       SenderType
  senderUserId     String?
  senderUser       User?        @relation(fields: [senderUserId], references: [id])
  content          String?      @db.Text
  mediaUrl         String?
  mediaType        MediaType    @default(TEXT)
  metaMessageId    String?      @unique // ID del mensaje en WhatsApp Cloud API
  status           String?      // SENT, DELIVERED, READ
  createdAt        DateTime     @default(now())
}

model InternalComment {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId         String
  author           User         @relation(fields: [authorId], references: [id])
  content          String       @db.Text
  mentions         String[]     // Array de User IDs mencionados
  createdAt        DateTime     @default(now())
}

model Reminder {
  id               String       @id @default(uuid())
  contactId        String
  contact          Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledFor     DateTime     // Fecha y hora del recordatorio pactado
  notes            String       @db.Text
  isCompleted      Boolean      @default(false)
  createdAt        DateTime     @default(now())
}

model Backorder {
  id               String       @id @default(uuid())
  contactId        String?
  contact          Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  providerId       String?
  provider         HelpdeskProvider? @relation(fields: [providerId], references: [id])
  orderNumber      String?
  productName      String
  category         String?      
  quantity         Int          @default(1)
  specification    String?      
  notes            String?      @db.Text
  photoUrl         String?      
  createdAt        DateTime     @default(now())
  businessLine     String       @default("3D")
  metadata         Json? // for dynamic backorder fields 
}

model ContactTag {
  id               String       @id @default(uuid())
  contactId        String
  contact          Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagName          String
  createdAt        DateTime     @default(now())

  @@unique([contactId, tagName])
}


model SystemSetting {
  id   String @id @default("default")
  data Json   @default("{}")
}

model MetaTemplate {
  id           String   @id @default(uuid())
  name         String   @unique
  category     String   @default("MARKETING")
  language     String   @default("es")
  bodyText     String
  variables    String   @default("[]")
  status       String   @default("LOCAL")
  metaId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}


model Ticket {
  id               String    @id @default(uuid())
  ticketNumber     String    @unique // Ej: IDISM0972
  incidentType     String?
  subject          String?
  description      String?   @db.Text
  clientId         String?
  client           HelpdeskClient?  @relation(fields: [clientId], references: [id])
  equipment        String?
  priority         String?   // Baja, Media, Alta
  reportedBy       String?
  assignedUserId   String?
  assignedUser     User?     @relation(fields: [assignedUserId], references: [id])
  status           String    @default("ABIERTO") // Abierto, Seguimiento, Cerrado, etc.
  metadata         Json?
  createdAt        DateTime  @default(now())
  closedAt         DateTime?
  updatedAt        DateTime  @updatedAt

  reports          TicketReport[]
}

model TicketReport {
  id                 String    @id @default(uuid())
  ticketId           String
  ticket             Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  task               String?
  clientId           String?
  client             HelpdeskClient?  @relation(fields: [clientId], references: [id])
  equipment          String?
  technicianId       String?
  technician         User?     @relation(fields: [technicianId], references: [id])
  workDone           String?   @db.Text
  observation        String?   @db.Text
  startDate          DateTime?
  endDate            DateTime?
  status             String?
  attentionModality  String?   // Remoto, Presencial, Mixto
  clientName         String?
  clientEmail        String?
  clientSignatureUrl String?   // Firma del cliente
  emailStatus        String?   // Iniciado, Completado
  pdfUrl             String?
  ccEmail            String?
  techEmail          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}


model HelpdeskClient {
  id                    String    @id @default(uuid())
  code                  String?   // ID Cliente (ej: IDCL3D0001, IDCLSM0001)
  cedula                String?
  company               String?   // Empresa / Institucion
  name                  String
  lastNames             String?
  email                 String?
  phone                 String?
  city                  String?
  address               String?
  businessLine          String    @default("SM") // "SM" o "3D"
  lastServiceOrderDate  DateTime? // Fecha de ultima OS (SM)
  firstServiceOrderDate DateTime? // Fecha de primera OS (SM)
  clientStatus          String?   // Estado de Cliente (SM)
  incidentCount         Int?      // Incidencias creadas (SM)
  createdAt             DateTime  @default(now())

  tickets      Ticket[]
  reports      TicketReport[]
  equipments   HelpdeskEquipment[]
  serviceOrders3D ServiceOrder3D[]
}

model HelpdeskEquipment {
  id                 String    @id @default(uuid())
  code               String?   // ID Equipo (ej: IDE3D0001)
  name               String
  brand              String?
  model              String?
  serial             String?
  modality           String?   // Modalidad (SM)
  date               DateTime? // Fecha (SM)
  installDate        DateTime? // Fecha de instalacion
  warrantyEndDate    DateTime? // Fecha fin garantia
  contractStartDate  DateTime? // Fecha inicio contrato
  contractEndDate    DateTime? // Fecha fin contrato
  clientId           String?
  businessLine       String    @default("SM")
  client             HelpdeskClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceOrders3D ServiceOrder3D[]
  createdAt          DateTime  @default(now())
}

model HelpdeskIncidentType {
  id           String   @id @default(uuid())
  name         String
  businessLine String   @default("SM")
  createdAt    DateTime @default(now())
}

model HelpdeskTaskType {
  id           String   @id @default(uuid())
  code         String?  // Id Tarea
  name         String
  type         String?  // Tipo
  description  String?  // Descripcion
  flow         String?  // Flujo asignado
  businessLine String   @default("SM")
  createdAt    DateTime @default(now())
}

model HelpdeskReception {
  id        String   @id @default(uuid())
  code      String?  // Id Recepcion
  name      String
  createdAt DateTime @default(now())
}

model HelpdeskService {
  id             String   @id @default(uuid())
  code           String?  // Id Servicio
  type           String?  // Tipo
  description    String?  // Descripcion
  flow           String?  // Flujo asignado
  estimatedPrice String?  // Precio Estimado (3D)
  serviceOrders3D ServiceOrder3D[]
  businessLine   String   @default("3D")
  createdAt      DateTime @default(now())
}

model HelpdeskEtaType {
  id           String   @id @default(uuid())
  code         String?  // Id Tipo ETA
  type         String?  // Tipo
  description  String?  // Descripcion
  service      String?  // Servicio
  businessLine String   @default("3D")
  createdAt    DateTime @default(now())
}




model Parameter {
  id          String      @id @default(uuid())
  parentId    String?
  parent      Parameter?  @relation("ParameterTree", fields: [parentId], references: [id])
  children    Parameter[] @relation("ParameterTree")
  mnemonic    String?     // Removed unique because many items might share mnemonic? No, mnemonics are usually unique for roots. Let's make it unique but optional.
  name        String
  value       String?
  description String?
  active      Boolean     @default(true)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  

  @@unique([mnemonic])
}


model HelpdeskProvider {
  id           String   @id @default(uuid())
  name         String
  businessLine String   @default("3D")
  createdAt    DateTime @default(now())

  backorders   Backorder[]
}

model ServiceOrder3D {
  id             String    @id @default(uuid())
  code           String?   @unique
  fecha          DateTime?
  clienteId      String?
  equipoId       String?
  servicioId     String?
  asesor         String?
  compromiso     String?   // imagen (URL/ruta)
  cliente        HelpdeskClient?    @relation(fields: [clienteId], references: [id])
  equipo         HelpdeskEquipment? @relation(fields: [equipoId], references: [id])
  servicio       HelpdeskService?   @relation(fields: [servicioId], references: [id])
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime  @default(now())
}

model PurchaseOrder {
  id                     String         @id @default(uuid())
  serviceOrderId         String
  serviceOrder           ServiceOrder3D @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  ordenNo                String?
  fecha                  DateTime?
  recepcion              String?
  observaciones          String?   @db.Text
  precio                 String?
  abono                  String?
  subtotal               String?
  nombreAsesor           String?
  firmaCliente           String?
  revisadoPor            String?
  generarPdf             String?
  video                  String?
  estado                 String?
  tarea                  String?
  descripcionPresupuesto String?   @db.Text
  presupuestoAprobado    String?
  precioPresupuesto      String?
  tiempoFinalizacion     String?
  servicioTipo           String?
  asesorTipo             String?
  diagnosticoRealizado   String?   @db.Text
  tecnico                String?
  realizadoPor           String?
  vendedoraNegocia       String?
  servicioRealizado      String?
  cobrado                String?
  entregado              String?
  cobradoPor             String?
  entregadoPor           String?
  observacionProduccion  String?   @db.Text
  observacionNegociacion String?   @db.Text
  createdAt              DateTime  @default(now())
}
model HelpdeskSparePart {
  id           String   @id @default(uuid())
  name         String
  businessLine String   @default("3D")
  createdAt    DateTime @default(now())
}
