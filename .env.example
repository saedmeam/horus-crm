# Archivo de Entorno de Ejemplo para Docker Compose
# Renombra este archivo a .env antes de hacer "docker-compose up" en el nuevo equipo.

# --- BASE DE DATOS ---
POSTGRES_USER=horus
POSTGRES_PASSWORD=horuspassword
POSTGRES_DB=horuscrm

# --- BACKEND ---
JWT_SECRET=pon_aqui_una_contraseña_muy_larga_y_segura

# --- FRONTEND ---
# IMPORTANTE: Cambia "localhost" por la Dirección IP del nuevo equipo dentro de tu red (ej. http://192.168.1.50:4001)
# Si lo dejas como localhost, el frontend intentará conectarse al backend de la computadora cliente, en vez de al servidor.
# Nota: El backend ahora corre en el puerto 4001 hacia el exterior.
NEXT_PUBLIC_API_URL=http://localhost:4001
