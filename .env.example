# Archivo de Entorno para Docker Compose
# Copia este archivo a `.env` en la raíz del proyecto antes de `docker compose up`.

# --- BASE DE DATOS ---
POSTGRES_USER=horus
POSTGRES_PASSWORD=horuspassword
POSTGRES_DB=horuscrm

# --- BACKEND ---
JWT_SECRET=pon_aqui_una_contrasena_muy_larga_y_segura

# Credenciales Meta (opcional: también puedes configurarlas desde la UI en /admin/configuracion)
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_horustech
DEFAULT_PHONE_NUMBER_ID=

# Usuario administrador inicial (se crea automáticamente con el seed en el primer arranque)
ADMIN_EMAIL=admin@horustech.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=horustech2026

# --- FRONTEND / BACKEND ---
# IMPORTANTE: usa la IP o dominio del SERVIDOR AlmaLinux (NO localhost), ej. http://192.168.1.50:4001
# El frontend se conecta al backend a través de esta URL (fetch + websockets) y el backend la usa para generar URLs de media.
NEXT_PUBLIC_API_URL=http://localhost:4001
